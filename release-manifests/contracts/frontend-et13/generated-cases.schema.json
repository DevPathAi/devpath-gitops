{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leva.ai.kr/schemas/et13/generated-cases.v1.json",
  "title": "Leva ET13 generated lane case catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_catalog_version",
    "catalog_sha256",
    "projection_contract_sha256",
    "projection_matrix",
    "fixture_ids",
    "case_count",
    "surface_case_counts",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "enum": ["leva.et13.visual-cases.v1", "leva.et13.a11y-cases.v1"]
    },
    "case_catalog_version": {"const": "leva.et13.catalog.v1"},
    "catalog_sha256": {"$ref": "#/$defs/sha256"},
    "projection_contract_sha256": {"$ref": "#/$defs/sha256"},
    "projection_matrix": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/projectionRow"}
    },
    "fixture_ids": {"$ref": "#/$defs/fixtureIds"},
    "case_count": {"type": "integer"},
    "surface_case_counts": {"type": "object"},
    "cases": {"type": "array"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {"const": "leva.et13.visual-cases.v1"}
        }
      },
      "then": {
        "properties": {
          "case_count": {"const": 96},
          "surface_case_counts": {"$ref": "#/$defs/visualCounts"},
          "cases": {
            "minItems": 96,
            "maxItems": 96,
            "items": {"$ref": "#/$defs/visualCase"}
          }
        }
      },
      "else": {
        "properties": {
          "case_count": {"const": 24},
          "surface_case_counts": {"$ref": "#/$defs/a11yCounts"},
          "cases": {
            "minItems": 24,
            "maxItems": 24,
            "items": {"$ref": "#/$defs/a11yCase"}
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fixtureIds": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "prefixItems": [
        {"const": "web-today-available"},
        {"const": "web-path-current-week"},
        {"const": "web-content-reading"},
        {"const": "web-workspace-idle"},
        {"const": "web-review-loaded"},
        {"const": "web-mentor-context-preview"},
        {"const": "admin-kpi-dashboard"},
        {"const": "admin-support-long-wire"},
        {"const": "mobile-today-available"},
        {"const": "mobile-content-reading"},
        {"const": "dp-design-mission-ledger"},
        {"const": "dp-design-context-payload-preview"}
      ],
      "items": false
    },
    "projectionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "capture_scope",
        "source_widget",
        "substitutions"
      ],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "capture_scope": {
          "enum": ["full_route", "body_projection", "component_projection"]
        },
        "source_widget": {"type": "string", "minLength": 1},
        "substitutions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "caseBase": {
      "type": "object",
      "required": [
        "case_id",
        "fixture_id",
        "owner",
        "distribution",
        "route",
        "ready_semantics_label",
        "surface_label",
        "capture_scope",
        "source_widget",
        "substitutions",
        "width",
        "height",
        "device_pixel_ratio",
        "theme",
        "text_scale_percent",
        "locale",
        "timezone",
        "reduced_motion",
        "artifact_path"
      ],
      "properties": {
        "case_id": {"type": "string"},
        "fixture_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "owner": {"enum": ["web", "admin", "mobile", "dp_design"]},
        "distribution": {"enum": ["web", "admin", "mobile"]},
        "route": {"type": "string", "pattern": "^/\\?fixture=[a-z0-9-]+$"},
        "ready_semantics_label": {
          "type": "string",
          "pattern": "^ET13_READY:[a-z0-9-]+$"
        },
        "surface_label": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "capture_scope": {
          "enum": ["full_route", "body_projection", "component_projection"]
        },
        "source_widget": {"type": "string", "minLength": 1},
        "substitutions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "width": {"enum": [320, 600, 840, 1240]},
        "height": {"const": 900},
        "device_pixel_ratio": {"const": 1},
        "theme": {"enum": ["light", "dark"]},
        "text_scale_percent": {"enum": [100, 200]},
        "locale": {"const": "ko-KR"},
        "timezone": {"const": "UTC"},
        "reduced_motion": {"const": true},
        "artifact_path": {"type": "string"}
      }
    },
    "visualCase": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/caseBase"},
        {
          "type": "object",
          "properties": {
            "case_id": {
              "pattern": "^[a-z0-9-]+--visual--w(?:320|600|840|1240)--(?:light|dark)$"
            },
            "text_scale_percent": {"const": 100},
            "artifact_path": {
              "pattern": "^visual/(?:web|admin|mobile|dp_design)/[a-z0-9.-]+\\.png$"
            }
          }
        }
      ]
    },
    "a11yCase": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/caseBase"},
        {
          "type": "object",
          "properties": {
            "case_id": {
              "pattern": "^[a-z0-9-]+--a11y--w(?:320--light|1240--dark)--text200$"
            },
            "width": {"enum": [320, 1240]},
            "text_scale_percent": {"const": 200},
            "artifact_path": {
              "pattern": "^a11y/(?:web|admin|mobile|dp_design)/[a-z0-9.-]+\\.json$"
            }
          }
        }
      ]
    },
    "visualCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "admin", "mobile", "dp_design"],
      "properties": {
        "web": {"const": 48},
        "admin": {"const": 16},
        "mobile": {"const": 16},
        "dp_design": {"const": 16}
      }
    },
    "a11yCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "admin", "mobile", "dp_design"],
      "properties": {
        "web": {"const": 12},
        "admin": {"const": 4},
        "mobile": {"const": 4},
        "dp_design": {"const": 4}
      }
    }
  }
}

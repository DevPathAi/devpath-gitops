    "candidateSpec": {
      "type": "object",
      "required": ["$schema", "schema_version", "document_type", "release_id", "created_at", "gitops", "services", "shared_migration", "frontend", "home", "analytics_privacy", "ai_release_eval_config", "environments", "journey_harness", "quality_evidence_inputs", "rollout"],
      "properties": {

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DevPathAi/devpath-gitops/release-manifests/schema-v1.json",
  "title": "Mission Spine immutable release documents v1",
  "description": "Two-stage contract: candidate-spec contains immutable inputs; release-manifest seals evidence against its SHA-256.",
  "type": "object",
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "document_type": {"enum": ["candidate-spec", "release-manifest"]},
    "release_id": {"$ref": "#/$defs/releaseId"},
    "created_at": {"type": "string", "format": "date-time"},
    "gitops": {"$ref": "#/$defs/gitops"},
    "services": {"$ref": "#/$defs/services"},
    "shared_migration": {"$ref": "#/$defs/sharedMigration"},
    "frontend": {"$ref": "#/$defs/frontend"},
    "home": {"$ref": "#/$defs/home"},
    "analytics_privacy": {"$ref": "#/$defs/analyticsPrivacy"},
    "ai_release_eval_config": {"$ref": "#/$defs/aiEvalConfig"},
    "environments": {"$ref": "#/$defs/environments"},
    "journey_harness": {"$ref": "#/$defs/journeyHarness"},
    "quality_evidence_inputs": {"$ref": "#/$defs/qualityEvidenceInputs"},
    "rollout": {"$ref": "#/$defs/rollout"},
    "candidate_spec": {"$ref": "#/$defs/candidateRef"},
    "home_dist_artifact": {"$ref": "#/$defs/homeArtifact"},
    "analytics_privacy_approval": {"$ref": "#/$defs/privacyApproval"},
    "ai_release_eval": {"$ref": "#/$defs/aiEval"},
    "journeys": {"$ref": "#/$defs/journeys"},
    "quality_evidence": {"$ref": "#/$defs/qualityEvidence"},
    "validation_attestation": {"$ref": "#/$defs/validationAttestation"}
  },
  "additionalProperties": false,
  "oneOf": [
    {"$ref": "#/$defs/candidateSpec"},
    {"$ref": "#/$defs/releaseManifest"}
  ],
  "$defs": {
    "releaseId": {
      "type": "string",
      "pattern": "^ms-[0-9]{8}-[a-z0-9][a-z0-9-]{2,40}$"
    },
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{1,127}$"},
    "component": {
      "type": "object",
      "required": ["repository", "source_sha", "image_repository", "image_digest"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "source_sha": {"$ref": "#/$defs/sha40"},
        "image_repository": {"type": "string", "pattern": "^ghcr\\.io/devpathai/devpath-[a-z-]+$"},
        "image_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "services": {
      "type": "object",
      "required": [
        "devpath-admin",
        "devpath-ai-svc",
        "devpath-community-svc",
        "devpath-gateway",
        "devpath-lcs-svc",
        "devpath-learning-svc",
        "devpath-notification-svc",
        "devpath-platform-svc",
        "devpath-sandbox-svc"
      ],
      "properties": {
        "devpath-admin": {"$ref": "#/$defs/component"},
        "devpath-ai-svc": {"$ref": "#/$defs/component"},
        "devpath-community-svc": {"$ref": "#/$defs/component"},
        "devpath-gateway": {"$ref": "#/$defs/component"},
        "devpath-lcs-svc": {"$ref": "#/$defs/component"},
        "devpath-learning-svc": {"$ref": "#/$defs/component"},
        "devpath-notification-svc": {"$ref": "#/$defs/component"},
        "devpath-platform-svc": {"$ref": "#/$defs/component"},
        "devpath-sandbox-svc": {"$ref": "#/$defs/component"}
      },
      "additionalProperties": false
    },
    "gitops": {
      "type": "object",
      "required": ["repository", "base_sha", "base_web_tag", "base_web_digest", "web_kustomization"],
      "properties": {
        "repository": {"const": "DevPathAi/devpath-gitops"},
        "base_sha": {"$ref": "#/$defs/sha40"},
        "base_web_tag": {"type": "string", "pattern": "^[0-9a-f]{40}(-mission-(off|on))?$", "description": "봉인된 신뢰 베이스의 사람용 태그. 신뢰의 실체는 base_web_digest — docs/mission-spine/web-trust-anchor-decision-2026-08-22.md"},
        "base_web_digest": {"$ref": "#/$defs/digest"},
        "web_kustomization": {"const": "apps/devpath-web/base/kustomization.yaml"}
      },
      "additionalProperties": false
    },
    "sharedMigration": {
      "type": "object",
      "required": ["repository", "source_sha", "shared_version", "shared_jar_sha256", "image_repository", "image_digest", "flyway_target", "required_migration", "rollback_policy"],
      "properties": {
        "repository": {"const": "DevPathAi/devpath-shared"},
        "source_sha": {"$ref": "#/$defs/sha40"},
        "shared_version": {"const": "0.0.1-et10.20260820"},
        "shared_jar_sha256": {"$ref": "#/$defs/sha64"},
        "image_repository": {"const": "ghcr.io/devpathai/devpath-migration"},
        "image_digest": {"$ref": "#/$defs/digest"},
        "flyway_target": {"const": "202608201002"},
        "required_migration": {"const": "V202608201002__validate_community_content_soft_delete.sql"},
        "rollback_policy": {"const": "additive-retained"}
      },
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "required": ["tag", "image_digest"],
      "properties": {
        "tag": {"type": "string", "pattern": "^[0-9a-f]{40}-mission-(off|on)$"},
        "image_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "frontendRollback": {
      "type": "object",
      "required": ["mission_off_digest", "prior_digest", "final_target"],
      "properties": {
        "mission_off_digest": {"$ref": "#/$defs/digest"},
        "prior_digest": {"$ref": "#/$defs/digest"},
        "final_target": {"const": "prior"}
      },
      "additionalProperties": false
    },
    "frontend": {
      "type": "object",
      "required": ["repository", "source_sha", "app_version", "analytics_contract_version", "flag_contract_version", "mission_off", "mission_on", "selected_on_digest", "rollback"],
      "properties": {
        "repository": {"const": "DevPathAi/devpath-frontend"},
        "source_sha": {"$ref": "#/$defs/sha40"},
        "app_version": {"$ref": "#/$defs/safeId"},
        "analytics_contract_version": {"const": "mission-spine.analytics.v1"},
        "flag_contract_version": {"const": "mission-spine.flag.v1"},
        "mission_off": {"$ref": "#/$defs/variant"},
        "mission_on": {"$ref": "#/$defs/variant"},
        "selected_on_digest": {"$ref": "#/$defs/digest"},
        "rollback": {"$ref": "#/$defs/frontendRollback"}
      },
      "additionalProperties": false
    },
    "home": {
      "type": "object",
      "required": ["repository", "source_sha", "dist_sha256", "cloudflare_account_id", "cloudflare_project", "candidate_deployment_id", "prior_production_deployment_id"],
      "properties": {
        "repository": {"const": "DevPathAi/devpath-home-page"},
        "source_sha": {"$ref": "#/$defs/sha40"},
        "dist_sha256": {"$ref": "#/$defs/sha64"},
        "cloudflare_account_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "cloudflare_project": {"$ref": "#/$defs/safeId"},
        "candidate_deployment_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "prior_production_deployment_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
      },
      "additionalProperties": false
    },
    "analyticsPrivacy": {
      "type": "object",
      "required": ["collection_mode", "approval_source_sha", "region", "project_identity", "retention_days", "access_owner", "deletion_runbook"],
      "properties": {
        "collection_mode": {"enum": ["explicit-consent", "approved-cookieless"]},
        "approval_source_sha": {"$ref": "#/$defs/sha40"},
        "region": {"const": "EU"},
        "project_identity": {"$ref": "#/$defs/safeId"},
        "retention_days": {"type": "integer", "minimum": 1, "maximum": 365},
        "access_owner": {"$ref": "#/$defs/safeId"},
        "deletion_runbook": {"$ref": "#/$defs/safeId"}
      },
      "additionalProperties": false
    },
    "aiEvalConfig": {
      "type": "object",
      "required": ["primary_model", "fallback_models", "prompt_sha256", "fixture_revision", "fixture_sha256", "rendered_config_sha256", "ollama_endpoint_sha256"],
      "properties": {
        "primary_model": {"$ref": "#/$defs/safeId"},
        "fallback_models": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/safeId"}},
        "prompt_sha256": {"$ref": "#/$defs/sha64"},
        "fixture_revision": {"$ref": "#/$defs/safeId"},
        "fixture_sha256": {"$ref": "#/$defs/sha64"},
        "rendered_config_sha256": {"$ref": "#/$defs/sha64"},
        "ollama_endpoint_sha256": {"$ref": "#/$defs/sha64"}
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["github_environment", "kubernetes_context", "namespace", "web_deployment", "web_container", "web_origin", "landing_origin"],
      "properties": {
        "github_environment": {"$ref": "#/$defs/safeId"},
        "kubernetes_context": {"$ref": "#/$defs/safeId"},
        "namespace": {"$ref": "#/$defs/safeId"},
        "web_deployment": {"$ref": "#/$defs/safeId"},
        "web_container": {"$ref": "#/$defs/safeId"},
        "web_origin": {"type": "string", "format": "uri", "pattern": "^https://"},
        "landing_origin": {"type": "string", "format": "uri", "pattern": "^https://"}
      },
      "additionalProperties": false
    },
    "environments": {
      "type": "object",
      "required": ["staging", "production"],
      "properties": {
        "staging": {"$ref": "#/$defs/environment"},
        "production": {"$ref": "#/$defs/environment"}
      },
      "additionalProperties": false
    },
    "dnsOverride": {
      "type": "object",
      "required": ["hostname", "address"],
      "properties": {
        "hostname": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
        "address": {"type": "string", "minLength": 3, "maxLength": 45}
      },
      "additionalProperties": false
    },
    "journeyHarness": {
      "type": "object",
      "required": ["landing_origin", "app_origin", "api_origin", "control_origin", "oauth_origin", "analytics_spy_origin", "dns_overrides"],
      "properties": {
        "landing_origin": {"type": "string", "format": "uri", "pattern": "^https://"},
        "app_origin": {"type": "string", "format": "uri", "pattern": "^https://"},
        "api_origin": {"type": "string", "format": "uri", "pattern": "^https://"},
        "control_origin": {"type": "string", "format": "uri", "pattern": "^https://"},
        "oauth_origin": {"type": "string", "format": "uri", "pattern": "^https://"},
        "analytics_spy_origin": {"type": "string", "format": "uri", "pattern": "^https://"},
        "dns_overrides": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/dnsOverride"}}
      },
      "additionalProperties": false
    },
    "qualityCatalog": {
      "type": "object",
      "required": ["repository", "source_sha", "path", "sha256", "case_count", "provenance_sha256"],
      "properties": {
        "repository": {"const": "DevPathAi/devpath-frontend"},
        "source_sha": {"$ref": "#/$defs/sha40"},
        "path": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.json$"},
        "sha256": {"$ref": "#/$defs/sha64"},
        "case_count": {"type": "integer", "minimum": 1},
        "provenance_sha256": {"$ref": "#/$defs/sha64", "description": "Precomputable producer input-provenance digest; never a post-run result-manifest or artifact-set digest."}
      },
      "additionalProperties": false
    },
    "frontendProjectionContract": {
      "type": "object",
      "required": ["schema_version", "projection_contract_sha256", "projection_matrix"],
      "properties": {
        "schema_version": {"const": "leva.et13.projection-contract.v1"},
        "projection_contract_sha256": {"const": "c66d08b6425628a06b27d07e08d648cfb3568d9db7c8d8aca2371172ccf4bde3"},
        "projection_matrix": {"const": [
          {"fixture_id": "web-today-available", "capture_scope": "body_projection", "source_widget": "TodayMissionSection", "substitutions": ["controller/provider state replaced by approved deterministic fixture"]},
          {"fixture_id": "web-path-current-week", "capture_scope": "body_projection", "source_widget": "MissionPathPlanView", "substitutions": ["controller/provider state replaced by approved deterministic fixture"]},
          {"fixture_id": "web-content-reading", "capture_scope": "body_projection", "source_widget": "WebContentProjection", "substitutions": ["AdSense slot replaced by explicit offline blocked-network evidence slot"]},
          {"fixture_id": "web-workspace-idle", "capture_scope": "body_projection", "source_widget": "SandboxLayout", "substitutions": ["controller state replaced by approved deterministic fixture", "Monaco callbacks disabled except production readiness"]},
          {"fixture_id": "web-review-loaded", "capture_scope": "component_projection", "source_widget": "WebReviewProjection", "substitutions": ["controller state replaced by approved deterministic fixture"]},
          {"fixture_id": "web-mentor-context-preview", "capture_scope": "body_projection", "source_widget": "WebMentorContextProjection", "substitutions": ["controller/provider state replaced by approved deterministic fixture"]},
          {"fixture_id": "admin-kpi-dashboard", "capture_scope": "body_projection", "source_widget": "AdminKpiDashboardProjection", "substitutions": ["controller/provider state replaced by approved deterministic fixture"]},
          {"fixture_id": "admin-support-long-wire", "capture_scope": "component_projection", "source_widget": "AdminSupportDetailProjection", "substitutions": ["live provider and dialog shell replaced by deterministic AlertDialog host"]},
          {"fixture_id": "mobile-today-available", "capture_scope": "body_projection", "source_widget": "MobileTodayProjection", "substitutions": ["native AppBar and route shell omitted", "controller/provider state replaced by approved deterministic fixture"]},
          {"fixture_id": "mobile-content-reading", "capture_scope": "body_projection", "source_widget": "MobileContentProjection", "substitutions": ["native AppBar and route shell omitted", "periodic dwell timer frozen", "controller/provider state replaced by approved deterministic fixture"]},
          {"fixture_id": "dp-design-mission-ledger", "capture_scope": "component_projection", "source_widget": "DpEt13MissionLedgerFixture", "substitutions": ["hosted by the Flutter Web production distribution"]},
          {"fixture_id": "dp-design-context-payload-preview", "capture_scope": "component_projection", "source_widget": "DpEt13ContextPayloadPreviewFixture", "substitutions": ["hosted by the Flutter Web production distribution"]}
        ]}
      },
      "additionalProperties": false
    },
    "frontendVisualCatalog": {
      "type": "object",
      "required": ["repository", "source_sha", "path", "sha256", "case_catalog_version", "case_catalog_schema_version", "projection_contract_sha256", "fixture_ids", "case_count", "surface_case_counts", "capture_surface", "device_evidence", "evidence_mode", "input_provenance_sha256", "input_provenance_file_sha256", "baseline_status", "baseline_set_sha256", "baseline_approval_sha256"],
      "properties": {
        "repository": {"const": "DevPathAi/devpath-frontend"},
        "source_sha": {"$ref": "#/$defs/sha40"},
        "path": {"const": "evidence/et13/generated/visual-cases.v1.json"},
        "sha256": {"$ref": "#/$defs/sha64"},
        "case_catalog_version": {"const": "leva.et13.catalog.v1"},
        "case_catalog_schema_version": {"const": "leva.et13.visual-cases.v1"},
        "projection_contract_sha256": {"const": "c66d08b6425628a06b27d07e08d648cfb3568d9db7c8d8aca2371172ccf4bde3"},
        "fixture_ids": {"const": ["web-today-available", "web-path-current-week", "web-content-reading", "web-workspace-idle", "web-review-loaded", "web-mentor-context-preview", "admin-kpi-dashboard", "admin-support-long-wire", "mobile-today-available", "mobile-content-reading", "dp-design-mission-ledger", "dp-design-context-payload-preview"]},
        "case_count": {"const": 96},
        "surface_case_counts": {"const": {"web": 48, "admin": 16, "mobile": 16, "dp_design": 16}},
        "capture_surface": {"const": "flutter_web_release_projection"},
        "device_evidence": {"const": false},
        "evidence_mode": {"const": "release_ready"},
        "input_provenance_sha256": {"$ref": "#/$defs/sha64", "description": "Canonical SHA-256 of provenance.v1.json with input_provenance_sha256 excluded, using sorted-key compact JSON."},
        "input_provenance_file_sha256": {"$ref": "#/$defs/sha64", "description": "Raw-byte SHA-256 of the packaged provenance.v1.json file."},
        "baseline_status": {"const": "approved"},
        "baseline_set_sha256": {"$ref": "#/$defs/sha64"},
        "baseline_approval_sha256": {"$ref": "#/$defs/sha64"}
      },
      "additionalProperties": false
    },
    "frontendAutomatedA11yCatalog": {
      "type": "object",
      "required": ["repository", "source_sha", "path", "sha256", "case_catalog_version", "case_catalog_schema_version", "projection_contract_sha256", "fixture_ids", "case_count", "surface_case_counts", "capture_surface", "device_evidence", "evidence_mode", "input_provenance_sha256", "input_provenance_file_sha256"],
      "properties": {
        "repository": {"const": "DevPathAi/devpath-frontend"},
        "source_sha": {"$ref": "#/$defs/sha40"},
        "path": {"const": "evidence/et13/generated/a11y-cases.v1.json"},
        "sha256": {"$ref": "#/$defs/sha64"},
        "case_catalog_version": {"const": "leva.et13.catalog.v1"},
        "case_catalog_schema_version": {"const": "leva.et13.a11y-cases.v1"},
        "projection_contract_sha256": {"const": "c66d08b6425628a06b27d07e08d648cfb3568d9db7c8d8aca2371172ccf4bde3"},
        "fixture_ids": {"const": ["web-today-available", "web-path-current-week", "web-content-reading", "web-workspace-idle", "web-review-loaded", "web-mentor-context-preview", "admin-kpi-dashboard", "admin-support-long-wire", "mobile-today-available", "mobile-content-reading", "dp-design-mission-ledger", "dp-design-context-payload-preview"]},
        "case_count": {"const": 24},
        "surface_case_counts": {"const": {"web": 12, "admin": 4, "mobile": 4, "dp_design": 4}},
        "capture_surface": {"const": "flutter_web_release_projection"},
        "device_evidence": {"const": false},
        "evidence_mode": {"const": "release_ready"},
        "input_provenance_sha256": {"$ref": "#/$defs/sha64", "description": "Canonical SHA-256 of provenance.v1.json with input_provenance_sha256 excluded, using sorted-key compact JSON."},
        "input_provenance_file_sha256": {"$ref": "#/$defs/sha64", "description": "Raw-byte SHA-256 of the packaged provenance.v1.json file."}
      },
      "additionalProperties": false
    },
    "homeQualityCatalog": {
      "type": "object",
      "required": ["repository", "source_sha", "rendered_product_sha", "rendered_product_tree_sha256", "path", "sha256", "case_count", "provenance_sha256", "font_manifest_sha256"],
      "properties": {
        "repository": {"const": "DevPathAi/devpath-home-page"},
        "source_sha": {"$ref": "#/$defs/sha40"},
        "rendered_product_sha": {"$ref": "#/$defs/sha40"},
        "rendered_product_tree_sha256": {"$ref": "#/$defs/sha64"},
        "path": {"const": "e2e/visual/case-catalog.v2.json"},
        "sha256": {"$ref": "#/$defs/sha64"},
        "case_count": {"type": "integer", "minimum": 1},
        "provenance_sha256": {"$ref": "#/$defs/sha64"},
        "font_manifest_sha256": {"$ref": "#/$defs/sha64"}
      },
      "additionalProperties": false
    },
    "qualityCatalogs": {
      "type": "object",
      "required": ["frontend-visual", "home-visual", "frontend-automated-a11y", "home-axe-browser-a11y", "manual-nvda", "manual-voiceover", "manual-talkback"],
      "properties": {
        "frontend-visual": {"$ref": "#/$defs/frontendVisualCatalog"},
        "home-visual": {"$ref": "#/$defs/homeQualityCatalog"},
        "frontend-automated-a11y": {"$ref": "#/$defs/frontendAutomatedA11yCatalog"},
        "home-axe-browser-a11y": {"$ref": "#/$defs/homeQualityCatalog"},
        "manual-nvda": {"allOf": [{"$ref": "#/$defs/qualityCatalog"}, {"properties": {"repository": {"const": "DevPathAi/devpath-frontend"}, "path": {"const": "tool/release-evidence/catalogs/manual-nvda.v1.json"}, "case_count": {"const": 2}}}]},
        "manual-voiceover": {"allOf": [{"$ref": "#/$defs/qualityCatalog"}, {"properties": {"repository": {"const": "DevPathAi/devpath-frontend"}, "path": {"const": "tool/release-evidence/catalogs/manual-voiceover.v1.json"}, "case_count": {"const": 4}}}]},
        "manual-talkback": {"allOf": [{"$ref": "#/$defs/qualityCatalog"}, {"properties": {"repository": {"const": "DevPathAi/devpath-frontend"}, "path": {"const": "tool/release-evidence/catalogs/manual-talkback.v1.json"}, "case_count": {"const": 4}}}]}
      },
      "additionalProperties": false
    },
    "mobileTestArtifacts": {
      "type": "object",
      "required": ["schema_version", "repository", "source_sha", "event", "workflow_path", "workflow_sha256", "workflow_run_id", "run_attempt", "artifact_id", "artifact_name", "artifact_archive_sha256", "build_provenance_file", "build_provenance_sha256", "signed_apk_file", "signed_apk_sha256", "signed_ipa_file", "signed_ipa_sha256"],
      "properties": {
        "schema_version": {"const": "leva.mission-spine.signed-mobile-build-binding.v1"},
        "repository": {"const": "DevPathAi/devpath-frontend"},
        "source_sha": {"$ref": "#/$defs/sha40"},
        "event": {"const": "workflow_dispatch"},
        "workflow_path": {"const": ".github/workflows/mission-spine-signed-mobile-build.yml"},
        "workflow_sha256": {"$ref": "#/$defs/sha64"},
        "workflow_run_id": {"type": "integer", "minimum": 1},
        "run_attempt": {"const": 1},
        "artifact_id": {"type": "integer", "minimum": 1},
        "artifact_name": {"$ref": "#/$defs/safeId"},
        "artifact_archive_sha256": {"$ref": "#/$defs/sha64"},
        "build_provenance_file": {"const": "build-provenance.v1.json"},
        "build_provenance_sha256": {"$ref": "#/$defs/sha64"},
        "signed_apk_file": {"const": "mobile/android/leva-release.apk"},
        "signed_apk_sha256": {"$ref": "#/$defs/sha64"},
        "signed_ipa_file": {"const": "mobile/ios/leva-release.ipa"},
        "signed_ipa_sha256": {"$ref": "#/$defs/sha64"}
      },
      "additionalProperties": false
    },
    "qualityEvidenceInputs": {
      "type": "object",
      "required": ["catalogs", "frontend_projection_contract", "mobile_test_artifacts"],
      "properties": {
        "catalogs": {"$ref": "#/$defs/qualityCatalogs"},
        "frontend_projection_contract": {"$ref": "#/$defs/frontendProjectionContract"},
        "mobile_test_artifacts": {"$ref": "#/$defs/mobileTestArtifacts"}
      },
      "additionalProperties": false
    },
    "rollout": {
      "type": "object",
      "required": ["sync_timeout_seconds", "canary_seconds", "rollback_budget_seconds", "synthetic_probe_path", "production_order", "rollback_order"],
      "properties": {
        "sync_timeout_seconds": {"const": 300},
        "canary_seconds": {"const": 900},
        "rollback_budget_seconds": {"const": 600},
        "synthetic_probe_path": {"const": "/internal/release/ready"},
        "production_order": {
          "const": ["shared-migration", "additive-services", "frontend-mission-off", "compatibility-smoke", "frontend-mission-on", "canary", "landing-last"]
        },
        "rollback_order": {
          "const": ["landing-prior", "frontend-mission-off", "frontend-prior", "retain-additive-services-and-schema"]
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
